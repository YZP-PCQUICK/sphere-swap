/* ========================================
   SWAP 校园交易平台 - 小程序全局样式
   与网站 style.css 同一套设计变量（375 设计稿，1px = 2rpx）
   ======================================== */

page {
  /* 主题色：科技浅蓝 */
  --primary-color: #4A90E2;
  --primary-light: #6AB0F3;
  --primary-dark: #357ABD;
  --primary-bg: #E8F4FD;
  --primary-gradient: linear-gradient(135deg, #6AB0F3 0%, #4A90E2 100%);
  --accent-color: #5FC3E4;
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #F5222D;
  --text-primary: #1F2937;
  --text-secondary: #6B7280;
  --text-light: #9CA3AF;
  --bg-page: #F5F9FC;
  --bg-white: #FFFFFF;
  --bg-card: #FFFFFF;
  --border-color: #E5E7EB;
  --border-light: #F0F2F5;
  --shadow-sm: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8rpx 24rpx rgba(74, 144, 226, 0.1);
  --shadow-lg: 0 16rpx 48rpx rgba(74, 144, 226, 0.15);
  --shadow-primary: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-full: 9999rpx;

  background: var(--bg-page);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 通用按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
  line-height: 1.4;
  box-sizing: border-box;
  transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--primary-gradient);
  color: #ffffff;
  box-shadow: var(--shadow-sm);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-primary.disabled {
  opacity: 0.6;
}

.btn-outline {
  background: transparent;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

.btn-outline:active {
  background: var(--primary-bg);
}

.btn-light {
  background: var(--bg-white);
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
}

.btn-light:active {
  border-color: var(--primary-color);
  color: var(--primary-color);
}

.btn-danger {
  background: var(--error-color);
  color: #ffffff;
}

.btn-sm {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
}

.btn-lg {
  padding: 28rpx 56rpx;
  font-size: 32rpx;
  min-height: 80rpx;
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.6;
}

/* 修复：小程序原生 button 默认样式 button:not([size='mini']) { width: 184px }
   优先级高于普通类名，导致 .btn-block 不生效；用同级结构提升优先级 */
button.btn-block {
  width: 100%;
  display: flex;
  margin-left: 0;
  margin-right: 0;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  border-radius: var(--radius-full);
  background: var(--primary-bg);
  color: var(--primary-color);
  font-weight: 500;
}

.tag-outline {
  background: transparent;
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
}

/* ---------- 表单 ---------- */
.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.form-label .required {
  color: var(--error-color);
  margin-left: 4rpx;
}

.form-label .label-hint {
  color: var(--text-light);
  font-weight: normal;
  font-size: 24rpx;
  margin-left: 16rpx;
}

.form-input {
  width: 100%;
  height: 92rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 32rpx;
  background: var(--bg-white);
  box-sizing: border-box;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.form-input-focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 6rpx rgba(74, 144, 226, 0.1);
}

.form-textarea {
  width: 100%;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 32rpx;
  min-height: 240rpx;
  line-height: 1.6;
  box-sizing: border-box;
  background: var(--bg-white);
}

.form-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.form-error {
  font-size: 24rpx;
  color: var(--error-color);
  margin-top: 12rpx;
}

.form-success {
  font-size: 24rpx;
  color: #34A853;
  margin-top: 12rpx;
}

/* ---------- 区块标题（网站 section-title 带左侧渐变条） ---------- */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 40rpx;
  background: var(--primary-gradient);
  border-radius: 4rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.section-more {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ---------- 图片清晰度 ---------- */
image {
  image-rendering: -webkit-optimize-contrast;
}

/* ---------- 淡入上浮动画 ---------- */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in-up {
  animation: fadeInUp 0.5s ease backwards;
}
