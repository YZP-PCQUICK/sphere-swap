<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{selected === index ? 'tab-item-active' : ''}}"
    data-path="{{item.path}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <image
        class="tab-icon"
        src="{{selected === index ? item.activeIcon : item.icon}}"
        mode="aspectFit"
      />
      <view wx:if="{{index === 1 && badge > 0}}" class="tab-badge">{{badge > 99 ? '99+' : badge}}</view>
    </view>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
