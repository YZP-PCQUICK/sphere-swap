.container {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== Hero ===== */
.hero {
  background: linear-gradient(135deg, #E8F4FD 0%, #D0E8F8 50%, #B8DBF3 100%);
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
  margin-bottom: 48rpx;
  position: relative;
  overflow: hidden;
}

.hero-circle {
  position: absolute;
  border-radius: 50%;
}

.hero-circle-1 {
  right: -100rpx;
  top: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(74, 144, 226, 0.1);
}

.hero-circle-2 {
  right: 160rpx;
  bottom: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(95, 195, 228, 0.15);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.hero-highlight {
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  color: transparent;
}

.hero-title-sub {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  line-height: 1.3;
}

.hero-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.hero-search {
  display: flex;
  align-items: center;
}

.hero-search-input {
  flex: 1;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  box-shadow: var(--shadow-sm);
  background: var(--bg-white);
  box-sizing: border-box;
}

.hero-search-btn {
  margin-left: 20rpx;
  padding: 24rpx 48rpx;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: var(--shadow-md);
  flex-shrink: 0;
}

/* ===== 广告展示栏（16:9） ===== */
.ad-banner {
  width: 100%;
  height: 0;
  padding-top: 56.25%;
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--bg-page);
  box-shadow: var(--shadow-md);
  margin-bottom: 48rpx;
  box-sizing: border-box;
}

.ad-banner-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ===== 通用区块 ===== */
.category-section,
.goods-section {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
  padding-left: 22rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 7rpx;
  height: 34rpx;
  background: var(--primary-gradient);
  border-radius: 4rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ===== 分类网格 ===== */
.category-grid {
  display: flex;
  flex-wrap: wrap;
}

.category-item {
  width: 25%;
  box-sizing: border-box;
  padding: 14rpx;
  background: transparent;
}

.category-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 28rpx 16rpx 22rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease;
}

.category-item:active .category-card {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-md);
}

.category-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 14rpx;
  background: var(--primary-bg);
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.category-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* ===== 商品卡片网格 ===== */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -12rpx;
}

.goods-card {
  width: 50%;
  box-sizing: border-box;
  padding: 12rpx;
}

.goods-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease;
}

.goods-card:active {
  transform: scale(0.98);
}

.goods-card-img {
  width: 100%;
  height: 0;
  padding-top: 100%;
  position: relative;
  background: var(--bg-page);
}

.goods-card-img-el {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  image-rendering: -webkit-optimize-contrast;
}

.goods-card-img-empty {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.goods-card-img-empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
  opacity: 0.6;
}

.goods-card-img-empty-text {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 空状态（与其他页面统一的小图标样式） */
.empty-state {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-state-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 发布商品悬浮按钮 */
.fab-publish {
  position: fixed;
  right: 30rpx;
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  z-index: 998;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.4);
}

.fab-publish:active {
  transform: scale(0.94);
  opacity: 0.9;
}

.fab-publish-icon {
  width: 36rpx;
  height: 36rpx;
}

.fab-publish-icon image,
.fab-publish image {
  filter: brightness(0) invert(1);
}

.fab-publish-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.goods-card-body {
  padding: 20rpx 20rpx 22rpx;
}

.goods-card-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  min-height: 78rpx;
}

.goods-card-price {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.goods-card-price-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--error-color);
}

.goods-card-price-num::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.goods-card-original-price {
  font-size: 22rpx;
  color: var(--text-light);
  text-decoration: line-through;
  margin-left: 10rpx;
}

.goods-card-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-card-school {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.goods-card-views {
  font-size: 22rpx;
  color: var(--text-light);
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.goods-card-views-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 4rpx;
}
