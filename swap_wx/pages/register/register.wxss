.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.auth-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--bg-white);
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
  box-shadow: var(--shadow-lg);
  animation: fadeInUp 0.5s ease;
  box-sizing: border-box;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.auth-header {
  text-align: center;
  margin-bottom: 44rpx;
}

.auth-logo {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.auth-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-weight: 500;
  font-size: 28rpx;
  margin-bottom: 14rpx;
  color: var(--text-primary);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  box-sizing: border-box;
  background: var(--bg-white);
}

.verify-group {
  display: flex;
  align-items: center;
}

.verify-input {
  flex: 1;
}

.verify-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  white-space: nowrap;
}

.password-strength {
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--border-light);
  margin-top: 12rpx;
  overflow: hidden;
}

.password-strength-bar {
  height: 100%;
  width: 0;
  transition: all 0.3s ease;
  border-radius: 4rpx;
}

.strength-weak {
  width: 33%;
  background: var(--error-color);
}

.strength-medium {
  width: 66%;
  background: var(--warning-color);
}

.strength-strong {
  width: 100%;
  background: var(--success-color);
}

.disclaimer-box {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFD591;
  border-radius: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #AD6800;
}

.disclaimer-title {
  font-weight: 600;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.disclaimer-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.disclaimer-item {
  margin: 6rpx 0;
}

.disclaimer-strong {
  font-weight: 600;
}

.auth-footer {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.footer-link {
  color: var(--primary-color);
  font-weight: 500;
}
