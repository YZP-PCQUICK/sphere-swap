.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.edit-card,
.qrcode-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-weight: 500;
  font-size: 28rpx;
  margin-bottom: 14rpx;
  color: var(--text-primary);
}

.form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}

/* ===== 头像 ===== */
.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.avatar-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: var(--shadow-sm);
}

.avatar-edit-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary-gradient, #4A90E2);
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
}

.avatar-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 收款码 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: var(--primary-gradient);
  border-radius: 4rpx;
}

.qrcode-preview {
  width: 340rpx;
  height: 340rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--border-light);
  background: var(--bg-page);
  display: block;
  margin: 0 auto;
}

.qrcode-actions {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.qrcode-btn {
  padding: 16rpx 48rpx;
  font-size: 27rpx;
}

.qrcode-empty {
  border: 2rpx dashed var(--border-color);
  border-radius: var(--radius-md);
  background: var(--bg-page);
  padding: 60rpx 40rpx;
  text-align: center;
}

.qrcode-empty:active {
  border-color: var(--primary-color);
  background: var(--primary-bg);
}

.qrcode-empty-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.6;
}

.qrcode-empty-text {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.qrcode-empty-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}
