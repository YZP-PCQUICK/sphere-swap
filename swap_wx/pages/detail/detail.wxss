.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 图片区 ===== */
.detail-gallery {
  margin-bottom: 24rpx;
}

.main-image {
  width: 100%;
  height: 0;
  padding-top: 100%;
  background: var(--bg-page);
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
}

.main-swiper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.main-img {
  width: 100%;
  height: 100%;
  image-rendering: -webkit-optimize-contrast;
}

.main-img-empty {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.main-img-empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
  opacity: 0.5;
}

.main-img-empty-text {
  font-size: 26rpx;
  color: var(--text-light);
}

.sold-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 44rpx;
  font-weight: 700;
  z-index: 2;
}

.img-indicator {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  z-index: 2;
}

.thumb-list {
  white-space: nowrap;
  margin-top: 16rpx;
}

.thumb-item {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.thumb-item.active {
  border-color: var(--primary-color);
}

.thumb-img {
  width: 100%;
  height: 100%;
}

/* ===== 信息卡片 ===== */
.detail-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.status-on_sale {
  background: #E6F7E6;
  color: #52C41A;
}

.status-sold {
  background: #FFF1F0;
  color: #F5222D;
}

.status-offline {
  background: #F5F5F5;
  color: #8C8C8C;
}

.goods-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 20rpx;
  color: var(--text-primary);
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 32rpx;
  padding: 26rpx 34rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-md);
}

.goods-price {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--error-color);
}

.goods-price::before {
  content: '¥';
  font-size: 30rpx;
  font-weight: 500;
  margin-right: 4rpx;
}

.goods-original-price {
  font-size: 28rpx;
  color: var(--text-light);
  text-decoration: line-through;
  margin-left: 20rpx;
}

.goods-meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.meta-item {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 18rpx;
}

.meta-label {
  color: var(--text-light);
  flex-shrink: 0;
}

.meta-value {
  color: var(--text-primary);
  font-weight: 500;
}

/* ===== 卖家信息 ===== */
.seller-section {
  display: flex;
  align-items: center;
  padding: 26rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  margin-bottom: 32rpx;
}

.seller-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.seller-avatar-img {
  width: 100%;
  height: 100%;
}

.seller-avatar-default {
  width: 64rpx;
  height: 64rpx;
}

.seller-info {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.seller-name {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 6rpx;
}

.seller-school {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 操作按钮 ===== */
.action-row {
  display: flex;
}

.action-flex {
  flex: 1;
  padding: 24rpx;
  font-size: 30rpx;
}

.action-flex + .action-flex {
  margin-left: 20rpx;
}

.btn-block.disabled {
  opacity: 0.7;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.btn-block .action-icon {
  vertical-align: middle;
}

/* ===== 描述 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: var(--primary-gradient);
  border-radius: 4rpx;
}

.goods-description {
  line-height: 1.8;
  color: var(--text-secondary);
  font-size: 28rpx;
  word-break: break-word;
  white-space: pre-wrap;
  /* 与网站一致：描述区限高可滚动（网站 max-height:200px） */
  max-height: 400rpx;
  overflow-y: auto;
}

/* ===== 卖家其他商品 ===== */
.seller-goods-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.seller-goods-card {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx;
}

.seller-goods-img {
  width: 100%;
  height: 0;
  padding-top: 100%;
  position: relative;
  background: var(--bg-page);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.seller-goods-img-el {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.seller-goods-img-empty {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seller-goods-img-empty-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.4;
}

.seller-goods-body {
  padding: 10rpx 4rpx;
}

.seller-goods-title {
  font-size: 24rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seller-goods-price {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--error-color);
  margin-top: 4rpx;
}

/* ===== 加载页 ===== */
.loading-page {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
