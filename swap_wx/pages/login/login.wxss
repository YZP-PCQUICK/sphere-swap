.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.auth-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--bg-white);
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
  box-shadow: var(--shadow-lg);
  animation: fadeInUp 0.5s ease;
  box-sizing: border-box;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.auth-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.auth-logo {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.auth-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.auth-panel {
  display: none;
}

.auth-panel.active {
  display: block;
  animation: fadeInUp 0.35s ease;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-weight: 500;
  font-size: 28rpx;
  margin-bottom: 14rpx;
  color: var(--text-primary);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  box-sizing: border-box;
  background: var(--bg-white);
}

.verify-group {
  display: flex;
  align-items: center;
}

.verify-input {
  flex: 1;
}

.verify-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  white-space: nowrap;
}

.password-wrap {
  position: relative;
}

.password-input {
  padding-right: 96rpx;
}

.password-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.auth-helper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: -8rpx 0 32rpx;
  font-size: 24rpx;
}

.remember-me {
  display: flex;
  align-items: center;
  color: var(--text-secondary);
}

.checkbox {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-white);
}

.checkbox.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.checkbox-icon {
  width: 20rpx;
  height: 20rpx;
}

.helper-link {
  color: var(--text-secondary);
}

.auth-footer {
  text-align: center;
  margin-top: 36rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.footer-link {
  color: var(--primary-color);
  font-weight: 500;
}
