<view class="chat-layout" wx:if="{{loaded}}">
  <!-- 头部：商品缩略图 + 商品标题（售出提示）+ 对方昵称（角色）+ 价格，与网站 room.html 一致 -->
  <view class="chat-header">
    <image wx:if="{{goods.image}}" class="chat-hd-thumb" src="{{goods.image}}" mode="aspectFill" bindtap="goGoods" />
    <view class="chat-hd-info">
      <view class="chat-hd-title">
        {{goods.title}}
        <text wx:if="{{goodsSold}}" class="chat-hd-sold">（{{t.chat_goods_sold}}）</text>
      </view>
      <view class="chat-hd-sub">{{peerSub}}</view>
    </view>
    <view class="chat-hd-price" wx:if="{{goods.price}}">¥{{goods.price}}</view>
  </view>

  <!-- 消息区 -->
  <scroll-view class="chat-messages" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation
    enhanced show-scrollbar="{{false}}">
    <view wx:if="{{messages.length === 0 && !loadFailed}}" class="chat-date">{{t.chat_empty}}</view>
    <view wx:if="{{loadFailed && messages.length === 0}}" class="chat-date chat-date-error" bindtap="poll">{{loadFailedText}}</view>
    <block wx:for="{{messages}}" wx:key="idx">
      <!-- 系统消息 -->
      <view wx:if="{{item.is_sys}}" class="msg-sys" id="msg-{{item.idx}}">{{item.content}}</view>
      <!-- 普通消息（气泡 + 头像 + 时间，与网站消息气泡一致） -->
      <view wx:else class="msg {{item.is_me ? 'mine' : 'other'}}" id="msg-{{item.idx}}">
        <view class="msg-avatar">
          <image wx:if="{{item.avatar}}" class="msg-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
          <image wx:else class="msg-avatar-default" src="/images/icon-default-avatar.png" mode="aspectFit" />
        </view>
        <view class="msg-body">
          <view wx:if="{{item.type === 'image'}}" class="msg-media">
            <image class="msg-media-img" src="{{item.file}}" mode="aspectFill" bindtap="previewMsgImage"
              data-url="{{item.file}}" />
          </view>
          <video wx:elif="{{item.type === 'video'}}" class="msg-media-video" src="{{item.file}}" controls
            object-fit="contain" />
          <view wx:else class="msg-bubble">{{item.content}}</view>
          <view class="msg-time">{{item.created}}</view>
          <!-- TODO: 后端缺少接口：wxapi 未返回 my_read_max_id，暂无法展示「已读/未读」回执 -->
        </view>
      </view>
    </block>
    <view class="msg-bottom-pad" id="msg-bottom"></view>
  </scroll-view>

  <!-- 交易面板 -->
  <view class="chat-trade-panel" wx:if="{{tradeMode !== 'none'}}">
    <!-- 已完成 -->
    <block wx:if="{{tradeMode === 'completed'}}">
      <view class="trade-box">
        <view class="trade-tip trade-tip-success">✓ {{t.chat_status_completed}}</view>
        <view class="trade-tip">{{t.chat_completed_local}}</view>
      </view>
    </block>
    <!-- 已取消 -->
    <block wx:elif="{{tradeMode === 'cancelled'}}">
      <view class="trade-box">
        <view class="trade-tip trade-tip-error">{{t.chat_cancelled_tip}}</view>
        <view class="trade-tip">{{t.chat_cancelled_desc}}</view>
      </view>
    </block>
    <!-- 商品已售出 -->
    <block wx:elif="{{tradeMode === 'sold'}}">
      <view class="trade-box">
        <view class="trade-tip trade-tip-error">{{t.chat_sold_title}}</view>
        <view class="trade-tip">{{t.chat_sold_desc}}</view>
      </view>
    </block>
    <!-- 双方已确认：买家可见收款码 + 确认收货/取消；卖家提示等待收货 -->
    <block wx:elif="{{tradeMode === 'confirmed'}}">
      <view class="trade-box">
        <view class="trade-tip trade-tip-success">{{t.chat_both_confirmed_title}}</view>
        <block wx:if="{{isBuyer && sellerHasQrcode}}">
          <image class="qrcode-img" src="{{qrcodeUrl}}" mode="aspectFit" bindtap="previewQrcode" />
          <view class="trade-tip">{{scanPayText}}</view>
          <view class="trade-btns">
            <view class="btn btn-outline trade-btn" bindtap="cancelTrade">{{t.chat_cancel_trade}}</view>
            <view class="btn btn-primary trade-btn" bindtap="completeTrade">{{t.chat_confirm_buy}}</view>
          </view>
        </block>
        <block wx:elif="{{isBuyer}}">
          <view class="trade-tip">{{t.chat_no_qrcode}}</view>
          <view class="trade-btns">
            <view class="btn btn-outline trade-btn" bindtap="cancelTrade">{{t.chat_cancel_trade}}</view>
          </view>
        </block>
        <block wx:else>
          <view class="trade-tip">{{t.chat_buyer_view_qrcode}}</view>
        </block>
      </view>
    </block>
    <!-- 洽谈中：确认交易 / 待对方确认 / 取消交易（仅买家）/ 查看商品 -->
    <block wx:elif="{{tradeMode === 'trading'}}">
      <view wx:if="{{otherConfirmed && !myConfirmed}}" class="trade-tip-highlight">{{t.chat_peer_confirmed}}</view>
      <view class="trade-box">
        <view class="trade-btns">
          <view wx:if="{{myConfirmed}}" class="btn btn-outline trade-btn disabled">
            <image class="trade-btn-icon" src="/images/icon-check.png" mode="aspectFit" />{{t.chat_waiting_peer}}
          </view>
          <view wx:else class="btn btn-primary trade-btn" bindtap="confirmTrade">{{t.chat_confirm_trade}}</view>
          <view wx:if="{{isBuyer}}" class="btn btn-outline trade-btn" bindtap="cancelTrade">{{t.chat_cancel_trade}}</view>
          <view class="btn btn-light trade-btn" bindtap="goGoods">{{t.chat_view_goods}}</view>
        </view>
        <view class="trade-tip">{{t.chat_trade_tip_trading}}</view>
      </view>
    </block>
    <!-- 免责声明（网站每状态面板底部均带） -->
    <view class="trade-disclaimer">
      <view class="trade-disclaimer-title">
        <image class="trade-disclaimer-icon" src="/images/icon-warning.png" mode="aspectFit" />
        <text>{{t.chat_disclaimer_title}}</text>
      </view>
      <view>{{t.chat_disclaimer}}</view>
    </view>
  </view>

  <!-- 输入区：图片/视频工具栏 + 文字输入（仅洽谈中可发） -->
  <view class="chat-input" wx:if="{{canChat}}">
    <view class="chat-toolbar">
      <view class="tool-item" bindtap="chooseImage">
        <image class="tool-icon" src="/images/icon-image.png" mode="aspectFit" />
      </view>
      <view class="tool-item" bindtap="chooseVideo">
        <image class="tool-icon" src="/images/icon-camera.png" mode="aspectFit" />
      </view>
    </view>
    <view class="chat-input-row">
      <input class="chat-textarea" value="{{inputText}}" placeholder="{{t.chat_send_ph}}" confirm-hold
        adjust-position cursor-spacing="10" bindinput="onInputText" bindconfirm="sendText" />
      <view class="chat-send-btn {{inputText ? '' : 'disabled'}}" bindtap="sendText">{{t.chat_send}}</view>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view wx:else class="loading-page">
  <view class="loading-spinner"></view>
  <view class="loading-text">{{t.loading}}</view>
</view>
