.page {
  padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 资料卡 ===== */
.profile-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 56rpx 40rpx 40rpx;
  text-align: center;
  position: relative;
  margin-bottom: 24rpx;
}

.profile-avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  image-rendering: -webkit-optimize-contrast;
}

.profile-avatar-empty {
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.profile-avatar-empty-icon {
  width: 88rpx;
  height: 88rpx;
  opacity: 0.7;
}

.profile-avatar-edit {
  position: absolute;
  top: 152rpx;
  left: 50%;
  transform: translateX(56rpx);
  width: 48rpx;
  height: 48rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
}

.profile-avatar-edit-icon {
  width: 26rpx;
  height: 26rpx;
}

.profile-name {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.profile-email {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
}

.profile-school {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
}

/* ===== 个人信息卡（与网站 profile.html 主内容区一致） ===== */
.info-card {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.info-group {
  margin-bottom: 28rpx;
}

.info-label {
  font-size: 25rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
  word-break: break-all;
}

.info-bio {
  line-height: 1.6;
}

.payment-qrcode {
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  background: var(--bg-page);
}

.payment-empty {
  width: 320rpx;
  height: 320rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.payment-empty-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.5;
  margin-bottom: 12rpx;
}

.payment-empty-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.info-tip {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.info-edit-btn {
  margin-top: 8rpx;
}

.profile-stats {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--border-light);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: var(--border-light);
}

/* ===== 菜单 ===== */
.menu-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
}

.menu-item:active {
  background: var(--bg-page);
}

.menu-item + .menu-item {
  border-top: 1rpx solid var(--border-light);
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 22rpx;
}

.menu-text {
  flex: 1;
  font-size: 29rpx;
  color: var(--text-primary);
}

.menu-text-publish {
  color: #4A90E2;
  font-weight: 600;
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-light);
  line-height: 1;
}

/* ===== 退出登录 ===== */
.logout-btn {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 28rpx;
  text-align: center;
  font-size: 29rpx;
  color: var(--error-color);
  font-weight: 500;
}

.logout-btn:active {
  background: #FFF1F0;
}

/* ===== 未登录 ===== */
.login-card {
  padding: 80rpx 40rpx;
}

.login-logo {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.login-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.login-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.login-btn {
  margin: 40rpx auto 0;
  width: 80%;
}

.login-btn + .login-btn {
  margin-top: 20rpx;
}

.profile-icp {
  margin-top: 40rpx;
  padding-bottom: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}

