.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 主Tab ===== */
.main-tabs {
  display: flex;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.main-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 29rpx;
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  font-weight: 500;
}

.main-tab.active {
  background: var(--primary-gradient);
  color: #fff;
}

/* ===== 子Tab ===== */
.sub-tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.sub-tab {
  padding: 12rpx 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-white);
  border-radius: 999rpx;
  margin-right: 16rpx;
  box-shadow: var(--shadow-sm);
}

.sub-tab.active {
  background: var(--primary-bg);
  color: var(--primary-color);
  font-weight: 600;
}

/* ===== 商品/交易行 ===== */
.goods-list {
  display: flex;
  flex-direction: column;
}

.goods-row {
  display: flex;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.goods-row-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--bg-page);
}

.goods-row-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-row-thumb-empty-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.4;
}

.goods-row-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-row-badges {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.goods-status {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

/* 与网站 status-badge 色系一致 */
.status-on_sale {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
}

.status-sold {
  background: rgba(74, 144, 226, 0.1);
  color: var(--primary-color);
}

.status-offline {
  background: rgba(154, 154, 154, 0.1);
  color: #9a9a9a;
}

.status-trading {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.status-confirmed {
  background: #FFF7E6;
  color: #FAAD14;
}

.status-completed {
  background: #E6F7E6;
  color: #52C41A;
}

.status-cancelled {
  background: rgba(245, 34, 45, 0.1);
  color: var(--error-color);
}

.goods-row-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.goods-row-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--error-color);
  margin-top: 8rpx;
}

.goods-row-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  min-width: 0;
}

.goods-row-school {
  font-size: 23rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-row-repeat {
  font-size: 20rpx;
  color: var(--primary-color);
  background: rgba(74, 144, 226, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.trade-status {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* 价格 + 操作行（与网站 goods-item-bottom 一致） */
.goods-item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.goods-row-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 0;
}

/* 重复售卖复选框（与网站 checkbox 一致） */
.repeat-toggle {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.repeat-toggle-text {
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
  white-space: nowrap;
}

.checkbox {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  background: var(--bg-white);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.checkbox.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.checkbox-check {
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
}

.action-btn {
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  background: var(--bg-page);
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
  border: 1rpx solid var(--border-color);
}

.action-btn.primary {
  background: var(--primary-gradient);
  color: #fff;
  border-color: transparent;
}

.action-btn.danger {
  color: var(--error-color);
  border-color: var(--error-color);
  background: #fff;
}

/* ===== 空状态 ===== */
.empty-state {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-state-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
