.page {
  padding: 20rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 会话项（对齐网站 conv-item：商品图 + 标题 + 最后消息 + 价格/状态/未读） ===== */
.conv-item {
  display: flex;
  align-items: center;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.conv-item-hover {
  border-color: var(--primary-color);
  box-shadow: var(--shadow-md);
}

/* 关联商品缩略图（网站 conv-thumb） */
.conv-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-page);
  flex-shrink: 0;
}

.conv-thumb-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-light);
  font-size: 40rpx;
  font-weight: 600;
}

.conv-body {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.conv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 主行：商品标题（网站以商品标题为会话名） */
.conv-peername {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conv-last {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 对方信息行：头像 + 昵称 */
.conv-peer-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  min-width: 0;
}

.conv-peer-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.conv-peer-avatar-fallback {
  background: var(--primary-gradient);
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.conv-peer-nick {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧信息列：时间 / 价格 / 状态 / 未读角标 */
.conv-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  gap: 8rpx;
}

.conv-time {
  font-size: 20rpx;
  color: var(--text-light);
}

/* 价格（网站 conv-price：红色加粗） */
.conv-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--error-color);
}

/* 状态徽章（配色对齐网站：confirmed 绿 / completed 蓝 / 其余灰） */
.conv-status {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--bg-page);
  color: var(--text-secondary);
}

.status-confirmed {
  background: #E7F6EC;
  color: #07C160;
}

.status-completed {
  background: #EBF1FF;
  color: var(--primary-color);
}

/* 未读数角标（网站 conv-badge：红色圆形数字） */
.conv-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--error-color);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* ===== 空状态（对齐网站 conv-empty） ===== */
.empty-state {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-state-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.empty-state-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.empty-btn {
  margin: 48rpx auto 0;
  width: 280rpx;
}
