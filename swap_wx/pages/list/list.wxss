.page {
  padding: 20rpx 24rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

/* 发布商品悬浮按钮 */
.fab-publish {
  position: fixed;
  right: 30rpx;
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  z-index: 998;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.4);
}

.fab-publish:active {
  transform: scale(0.94);
  opacity: 0.9;
}

.fab-publish image {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1);
}

.fab-publish-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.search-input-wrap {
  flex: 1;
  position: relative;
}

.search-input {
  width: 100%;
  height: 76rpx;
  padding: 0 70rpx 0 28rpx;
  background: var(--bg-white);
  border-radius: 999rpx;
  font-size: 27rpx;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.search-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  color: var(--text-light);
  font-size: 32rpx;
}

.search-btn {
  margin-left: 16rpx;
  padding: 18rpx 36rpx;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* ===== 排序栏 ===== */
.sort-bar {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.sort-options {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.sort-option {
  display: inline-block;
  padding: 10rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
}

.sort-option.active {
  color: var(--primary-color);
  background: var(--primary-bg);
  font-weight: 500;
}

.result-count {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.result-count-num {
  color: var(--primary-color);
  font-weight: 600;
}

.filter-btn {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  background: var(--primary-bg);
  color: var(--primary-color);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  flex-shrink: 0;
}

.filter-btn-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

/* ===== 商品网格 ===== */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -12rpx;
}

.goods-card {
  width: 50%;
  box-sizing: border-box;
  padding: 12rpx;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.goods-card:active {
  transform: scale(0.98);
}

.goods-card-img {
  width: 100%;
  height: 0;
  padding-top: 100%;
  position: relative;
  background: var(--bg-page);
}

.goods-card-img-el {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  image-rendering: -webkit-optimize-contrast;
}

.goods-card-img-empty {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.goods-card-img-empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
  opacity: 0.6;
}

.goods-card-img-empty-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.goods-card-body {
  padding: 20rpx 20rpx 22rpx;
}

.goods-card-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  min-height: 78rpx;
}

.goods-card-price {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.goods-card-price-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--error-color);
}

.goods-card-price-num::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.goods-card-free {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--success-color);
}

.goods-card-original-price {
  font-size: 22rpx;
  color: var(--text-light);
  text-decoration: line-through;
  margin-left: 10rpx;
}

.goods-card-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-card-school {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 40%;
}

.goods-card-time {
  font-size: 22rpx;
  color: var(--text-light);
  margin-right: 8rpx;
  flex-shrink: 0;
}

.goods-card-views {
  font-size: 22rpx;
  color: var(--text-light);
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.goods-card-views-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 4rpx;
}

/* ===== 分页 ===== */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
}

.page-btn {
  padding: 14rpx 32rpx;
  background: var(--bg-white);
  color: var(--primary-color);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  box-shadow: var(--shadow-sm);
}

.page-btn.disabled {
  color: var(--text-light);
  background: var(--bg-page);
}

.page-current {
  margin: 0 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ===== 空状态 ===== */
.empty-state {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-state-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.empty-state-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

/* ===== 筛选抽屉 ===== */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.filter-mask.show {
  opacity: 1;
  visibility: visible;
}

.filter-panel {
  position: fixed;
  right: -100%;
  top: 0;
  bottom: 0;
  width: 84%;
  max-width: 640rpx;
  background: var(--bg-white);
  z-index: 201;
  transition: right 0.3s ease;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.filter-panel.show {
  right: 0;
}

.filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.filter-head-title {
  font-size: 34rpx;
  font-weight: 700;
}

.filter-close {
  width: 72rpx;
  height: 72rpx;
  font-size: 44rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.filter-close:active {
  background: var(--bg-page);
}

.filter-group {
  margin-bottom: 36rpx;
}

.filter-label {
  font-size: 25rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 12rpx 26rpx;
  background: var(--bg-page);
  border-radius: 999rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
  margin: 0 12rpx 12rpx 0;
  border: 1rpx solid transparent;
}

.filter-option.active {
  background: var(--primary-gradient);
  color: white;
}

.filter-price {
  display: flex;
  align-items: center;
}

.filter-price-input {
  flex: 1;
  padding: 14rpx 20rpx;
  font-size: 25rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  min-width: 0;
}

.filter-price-sep {
  color: var(--text-light);
  margin: 0 14rpx;
}

.filter-school-input {
  width: 100%;
  padding: 14rpx 20rpx;
  font-size: 25rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.filter-actions {
  display: flex;
  margin-top: 40rpx;
}

.filter-reset {
  flex: 1;
  padding: 20rpx;
  background: var(--bg-page);
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  text-align: center;
  margin-right: 20rpx;
}

.filter-apply {
  flex: 1;
  padding: 20rpx;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  text-align: center;
}
